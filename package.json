{
  "name": "plusnet-mobile",
  "version": "0.4.2",
  "private": true,
  "description": "PlusNet for Android and iOS: download files over Wi-Fi and mobile data together",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --experimental-strip-types scripts/format.test.ts",
    "sync": "npm run build && cap sync",
    "test:native": "mkdir -p /tmp/plusnet-jc && java -m jdk.compiler/com.sun.tools.javac.Main -d /tmp/plusnet-jc plugins/plusnet-engine/android/src/main/java/app/plusnet/engine/ChunkMap.java plugins/plusnet-engine/android/src/main/java/app/plusnet/engine/Limiter.java plugins/plusnet-engine/android/src/main/java/app/plusnet/engine/Policy.java plugins/plusnet-engine/android/src/test/java/app/plusnet/engine/CoreCheck.java && java -ea -cp /tmp/plusnet-jc app.plusnet.engine.CoreCheck"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "lucide-react": "^0.468.0",
    "plusnet-engine": "file:./plugins/plusnet-engine",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
